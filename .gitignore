# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/

# Build output
dist/
build/

# Env files (never commit secrets)
.env
.env.local
.env.*.local

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# TypeScript
*.tsbuildinfo

# Supabase local
**/supabase/.branches
**/supabase/.temp

# Logs
npm-debug.log*
*.log

# OS
.DS_Store

# Editors
.vscode/
.idea/
.vercel

# Local Claude Code state — personal permission allowlist, never shared.
# (Ours currently embeds a live connector token inside a Bash(...) permission
# string, so this is a secrets concern, not just noise.)
.claude/settings.local.json

# Playwright authed-fixture state (contains a real, disposable session token)
apps/web/e2e/.auth/

# codex-task delegation transcripts — run artifacts, not source
.codex-runs/

# `npm pack` tarballs. They are a COMPILED SNAPSHOT of packages/*/dist (itself ignored above), so a
# committed one is a second copy of the build that goes stale the moment src moves and looks
# authoritative while it does — CODE-QUALITY.md #2 ("a value that must not go stale is computed,
# not written down"). Regenerate on demand: `npm pack -w @golden-frijoles/sdk`.
*.tgz

# Rendered reference states — DERIVED from the approved prototype, never stored.
# `apps/web/design-system/README.md` and `render-reference.mjs` have both said these are gitignored
# since `design-system-rails` Story 1.1 moved the design into the product. Nothing made it true, so
# 32 PNGs sat untracked in the epic's retired `Roadmap/**/design/` folder — a claim in a doc with no
# rule behind it, which is the defect class this epic is named after. Regenerate with
# `node apps/web/design-system/render-reference.mjs`.
apps/web/design-system/reference/
Roadmap/**/design/reference/
